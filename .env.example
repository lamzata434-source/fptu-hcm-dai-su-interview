# Supabase -> Project -> Connect -> Transaction pooler (port 6543); KHONG public gia tri nay
DATABASE_URL=postgresql://postgres.PROJECT_ID:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres
# Mat khau admin du dai, rieng biet, KHONG commit vao Git
ADMIN_PASSWORD=THAY_BANG_MAT_KHAU_ADMIN_MANH_DAI_24_KY_TU
# Chuoi ngau nhien >= 32 ky tu, khac mat khau admin
AUTH_SECRET=THAY_BANG_CHUOI_NGAU_NHIEN_64_KY_TU
# Thong bao truc tiep cho Quan tri (tuy chon). Supabase -> Project Settings -> API: Project URL va anon/publishable key.
# Hai gia tri nay la cong khai theo thiet ke cua Supabase; chi trang Quan tri da dang nhap moi nhan duoc.
SUPABASE_URL=https://PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=THAY_BANG_ANON_KEY
